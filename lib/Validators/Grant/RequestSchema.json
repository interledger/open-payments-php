{
  "type": "object",
  "required": ["client"],
  "anyOf": [
    { "required": ["access_token"] },
    { "required": ["interact", "subject"] }
  ],
  "properties": {
    "access_token": {
      "type": "object",
      "required": ["access"],
      "properties": {
        "access": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": ["type", "actions"],
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "incoming-payment"
                  },
                  "actions": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": ["create", "complete", "read", "read-all", "list", "list-all"]
                    },
                    "uniqueItems": true
                  },
                  "identifier": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["type", "actions", "identifier"],
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "outgoing-payment"
                  },
                  "actions": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": ["create", "read", "read-all", "list", "list-all"]
                    },
                    "uniqueItems": true
                  },
                  "identifier": {
                    "type": "string",
                    "format": "uri"
                  },
                  "limits": {
                    "type": "object",
                    "properties": {
                      "receiver": {
                        "type": "string",
                        "format": "uri"
                      },
                      "debitAmount": {
                        "type": "object",
                        "properties": {
                          "value": { "type": "string" },
                          "assetCode": { "type": "string" },
                          "assetScale": { "type": "integer" }
                        },
                        "required": ["value", "assetCode", "assetScale"]
                      },
                      "receiveAmount": {
                        "type": "object",
                        "properties": {
                          "value": { "type": "string" },
                          "assetCode": { "type": "string" },
                          "assetScale": { "type": "integer" }
                        },
                        "required": ["value", "assetCode", "assetScale"]
                      },
                      "interval": {
                        "type": "string"
                      }
                    },
                    "anyOf": [
                      { "required": ["debitAmount"] },
                      { "required": ["receiveAmount"] },
                      { "not": { "required": ["interval"] } }
                    ]
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["type", "actions"],
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "quote"
                  },
                  "actions": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": ["create", "read", "read-all"]
                    },
                    "uniqueItems": true
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "maxItems": 3,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "client": {
      "type": "string",
      "format": "uri"
    },
    "interact": {
      "type": "object",
      "required": ["start"],
      "properties": {
        "start": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["redirect"]
          }
        },
        "finish": {
          "type": ["object", "null"],
          "required": ["method", "uri", "nonce"],
          "properties": {
            "method": {
              "type": "string",
              "enum": ["redirect"]
            },
            "uri": {
              "type": "string",
              "format": "uri"
            },
            "nonce": {
              "type": "string"
            }
          }
        }
      }
    },
    "subject": {
      "type": "object",
      "required": ["sub_ids"],
      "properties": {
        "sub_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "format"],
            "properties": {
              "id": {
                "type": "string"
              },
              "format": {
                "type": "string",
                "enum": ["uri"]
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "amount": {
      "type": "object",
      "required": ["value", "assetCode", "assetScale"],
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "assetCode": {
          "type": "string"
        },
        "assetScale": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
